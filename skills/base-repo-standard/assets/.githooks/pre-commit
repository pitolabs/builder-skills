#!/bin/sh
# Refuses a commit whose staged changes carry a secret (the pinned gitleaks from mise.toml). In a repository that
# already has a pre-commit hook (a formatter, or privacy-scan.sh --staged from public-repo-standard, which runs this
# same scan), put the two lines below first in that hook instead of adding this file.
set -eu
command -v mise >/dev/null || { echo "pre-commit: mise is required (brew install mise; https://mise.jdx.dev)" >&2; exit 1; }
mise -C "$(git rev-parse --show-toplevel)" exec -- gitleaks git --pre-commit --staged --redact --no-banner --log-level warn .
